  ChessPiece[ChessPiece.ts{type: string, color: string, gridX: number, gridZ: number, active: boolean, mesh: any, isAnimating: boolean, animProgress: number, startX: number, startZ: number, targetGridX: number, targetGridZ: number, isCapturing: boolean, captureProgress: number}]
  ChessBoard[ChessBoard.ts{group: any, squares: any[][], highlights: any[]}]
  ChessGame[ChessGame.ts{scene: any, camera: any, renderer: any, clock: any, board: ChessBoard, pieces: ChessPiece[], selectedPiece: ChessPiece, validMoves: any[], turn: string, isAIOpponent: boolean, isGameOver: boolean, winner: string, history: any[], raycaster: any, mouse: any, isOrbiting: boolean, lastMouse: any, camAngleXZ: number, camAngleY: number, camRadius: number, audioCtx: any, explosions: any[]}]

  ChessGame --> ChessBoard

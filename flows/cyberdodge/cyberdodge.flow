extern->three from "three"
cliscripts->start npx -y http-server -p 3005 -c-1

// --- Classes ---

SoundEngine[SoundEngine.ts{ctx: any, engineOsc: any, engineGain: any, isMuted: boolean}]
@SoundEngine.constructor{}
@@SoundEngine.constructor.code
  this.ctx = null;
  this.engineOsc = null;
  this.engineGain = null;
  this.isMuted = false;
@@SoundEngine.constructor.end

@SoundEngine.init{}: void
@@SoundEngine.init.code
  if (this.ctx) return;
  const AudioContext = window.AudioContext || (window as any).webkitAudioContext;
  if (!AudioContext) return;
  this.ctx = new AudioContext();
  
  // Start engine oscillator
  this.engineOsc = this.ctx.createOscillator();
  this.engineOsc.type = "sawtooth";
  this.engineOsc.frequency.setValueAtTime(60, this.ctx.currentTime);
  
  this.engineGain = this.ctx.createGain();
  this.engineGain.gain.setValueAtTime(0.02, this.ctx.currentTime);
  
  const filter = this.ctx.createBiquadFilter();
  filter.type = "lowpass";
  filter.frequency.setValueAtTime(180, this.ctx.currentTime);
  
  this.engineOsc.connect(filter);
  filter.connect(this.engineGain);
  this.engineGain.connect(this.ctx.destination);
  this.engineOsc.start();
@@SoundEngine.init.end

@SoundEngine.setEngineSpeed{speed: number}: void
@@SoundEngine.setEngineSpeed.code
  if (!this.ctx || !this.engineOsc || this.isMuted) return;
  const targetFreq = 50 + speed * 1.5;
  this.engineOsc.frequency.setTargetAtTime(targetFreq, this.ctx.currentTime, 0.1);
@@SoundEngine.setEngineSpeed.end

@SoundEngine.playCollect{}: void
@@SoundEngine.playCollect.code
  if (!this.ctx || this.isMuted) return;
  const now = this.ctx.currentTime;
  const osc = this.ctx.createOscillator();
  const gain = this.ctx.createGain();
  
  osc.type = "triangle";
  const freqs = [523.25, 659.25, 783.99, 1046.50];
  osc.frequency.setValueAtTime(freqs[0], now);
  osc.frequency.setValueAtTime(freqs[1], now + 0.05);
  osc.frequency.setValueAtTime(freqs[2], now + 0.10);
  osc.frequency.setValueAtTime(freqs[3], now + 0.15);
  
  gain.gain.setValueAtTime(0.12, now);
  gain.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
  
  osc.connect(gain);
  gain.connect(this.ctx.destination);
  osc.start(now);
  osc.stop(now + 0.4);
@@SoundEngine.playCollect.end

@SoundEngine.playHit{}: void
@@SoundEngine.playHit.code
  if (!this.ctx || this.isMuted) return;
  const now = this.ctx.currentTime;
  
  const bufferSize = this.ctx.sampleRate * 0.4;
  const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
  const data = buffer.getChannelData(0);
  for (let i = 0; i < bufferSize; i++) {
    data[i] = Math.random() * 2 - 1;
  }
  
  const noise = this.ctx.createBufferSource();
  noise.buffer = buffer;
  
  const filter = this.ctx.createBiquadFilter();
  filter.type = "lowpass";
  filter.frequency.setValueAtTime(350, now);
  filter.frequency.exponentialRampToValueAtTime(10, now + 0.4);
  
  const gain = this.ctx.createGain();
  gain.gain.setValueAtTime(0.25, now);
  gain.gain.linearRampToValueAtTime(0.001, now + 0.4);
  
  noise.connect(filter);
  filter.connect(gain);
  gain.connect(this.ctx.destination);
  noise.start(now);
@@SoundEngine.playHit.end

@SoundEngine.playNearMiss{}: void
@@SoundEngine.playNearMiss.code
  if (!this.ctx || this.isMuted) return;
  const now = this.ctx.currentTime;
  const osc = this.ctx.createOscillator();
  const gain = this.ctx.createGain();
  
  osc.type = "sine";
  osc.frequency.setValueAtTime(1000, now);
  osc.frequency.exponentialRampToValueAtTime(2500, now + 0.12);
  
  gain.gain.setValueAtTime(0.06, now);
  gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);
  
  osc.connect(gain);
  gain.connect(this.ctx.destination);
  osc.start(now);
  osc.stop(now + 0.12);
@@SoundEngine.playNearMiss.end

@SoundEngine.playGameOver{}: void
@@SoundEngine.playGameOver.code
  if (!this.ctx || this.isMuted) return;
  const now = this.ctx.currentTime;
  
  const chords = [
    [220.00, 261.63, 329.63], 
    [196.00, 233.08, 293.66], 
    [174.61, 220.00, 261.63]  
  ];
  
  chords.forEach((notes, idx) => {
    notes.forEach(note => {
      const osc = this.ctx.createOscillator();
      const gain = this.ctx.createGain();
      
      osc.type = "sawtooth";
      osc.frequency.setValueAtTime(note, now + idx * 0.4);
      
      gain.gain.setValueAtTime(0.04, now + idx * 0.4);
      gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.4 + 0.38);
      
      const filter = this.ctx.createBiquadFilter();
      filter.type = "lowpass";
      filter.frequency.setValueAtTime(250, now + idx * 0.4);
      
      osc.connect(filter);
      filter.connect(gain);
      gain.connect(this.ctx.destination);
      osc.start(now + idx * 0.4);
      osc.stop(now + idx * 0.4 + 0.4);
    });
  });
@@SoundEngine.playGameOver.end

@SoundEngine.toggleMute{}: void
@@SoundEngine.toggleMute.code
  this.isMuted = !this.isMuted;
  if (this.isMuted && this.engineGain) {
    this.engineGain.gain.setValueAtTime(0, this.ctx ? this.ctx.currentTime : 0);
  } else if (!this.isMuted && this.engineGain && this.ctx) {
    this.engineGain.gain.setValueAtTime(0.02, this.ctx.currentTime);
  }
@@SoundEngine.toggleMute.end


RetroSun[RetroSun.ts{mesh: any, canvas: any, ctx: any, texture: any}]
@RetroSun.constructor{}
@@RetroSun.constructor.code
  this.canvas = document.createElement('canvas');
  this.canvas.width = 256;
  this.canvas.height = 256;
  this.ctx = this.canvas.getContext('2d');
  
  this.texture = new three.CanvasTexture(this.canvas);
  
  const geometry = new three.PlaneGeometry(35, 35);
  const material = new three.MeshBasicMaterial({
    map: this.texture,
    transparent: true,
    depthWrite: false
  });
  this.mesh = new three.Mesh(geometry, material);
  this.mesh.position.set(0, 7.5, -60);
@@RetroSun.constructor.end

@RetroSun.update{time: number}: void
@@RetroSun.update.code
  const c = this.ctx;
  c.clearRect(0, 0, 256, 256);
  
  c.save();
  c.beginPath();
  c.arc(128, 128, 120, 0, Math.PI * 2);
  c.clip();
  
  const grad = c.createLinearGradient(0, 0, 0, 256);
  grad.addColorStop(0, '#f43f5e'); 
  grad.addColorStop(0.5, '#ec4899'); 
  grad.addColorStop(1.0, '#eab308'); 
  c.fillStyle = grad;
  c.fillRect(0, 0, 256, 256);
  
  c.fillStyle = '#09090b'; 
  const numLines = 8;
  const speed = 12;
  const offset = (time * speed) % (256 / numLines);
  
  for (let i = 0; i < numLines + 2; i++) {
    const y = i * (256 / numLines) + offset;
    const pct = y / 256;
    const thickness = Math.max(2, pct * 20);
    if (y < 256) {
      c.fillRect(0, y, 256, thickness);
    }
  }
  
  c.restore();
  this.texture.needsUpdate = true;
@@RetroSun.update.end


GridFloor[GridFloor.ts{mesh: any, texture: any}]
@GridFloor.constructor{}
@@GridFloor.constructor.code
  const canvas = document.createElement('canvas');
  canvas.width = 128;
  canvas.height = 128;
  const ctx = canvas.getContext('2d');
  
  ctx.fillStyle = '#09090b'; 
  ctx.fillRect(0, 0, 128, 128);
  
  ctx.strokeStyle = '#c084fc'; 
  ctx.lineWidth = 4;
  ctx.strokeRect(0, 0, 128, 128);
  
  ctx.lineWidth = 1;
  ctx.strokeStyle = 'rgba(192, 132, 252, 0.35)';
  ctx.beginPath();
  ctx.moveTo(64, 0); ctx.lineTo(64, 128);
  ctx.moveTo(0, 64); ctx.lineTo(128, 64);
  ctx.stroke();
  
  this.texture = new three.CanvasTexture(canvas);
  this.texture.wrapS = three.RepeatWrapping;
  this.texture.wrapT = three.RepeatWrapping;
  this.texture.repeat.set(18, 55); 
  
  const geometry = new three.PlaneGeometry(100, 300, 10, 60); 
  const material = new three.MeshStandardMaterial({
    map: this.texture,
    roughness: 0.8,
    metalness: 0.2,
    emissive: 0x2e1065, 
    emissiveIntensity: 0.5
  });
  
  this.mesh = new three.Mesh(geometry, material);
  this.mesh.rotation.x = -Math.PI / 2;
  this.mesh.position.set(0, 0, -100); 
@@GridFloor.constructor.end

@GridFloor.update{time: number, speed: number, curve: number}: void
@@GridFloor.update.code
  const scrollSpeed = 0.05 * speed;
  this.texture.offset.y = -(time * scrollSpeed) % 1.0;
  
  const pos = this.mesh.geometry.attributes.position;
  const vCount = pos.count;
  
  for (let i = 0; i < vCount; i++) {
    const vertX = pos.getX(i);
    const vertY = pos.getY(i); 
    const worldZ = vertY + this.mesh.position.z;
    
    const zFactor = Math.max(0, -worldZ - 5); 
    const shift = curve * Math.pow(zFactor * 0.005, 2);
    
    const colIdx = i % 11; 
    const baseX = -50 + colIdx * 10;
    
    pos.setX(i, baseX + shift);
  }
  pos.needsUpdate = true;
@@GridFloor.update.end


Starfield[Starfield.ts{points: any}]
@Starfield.constructor{}
@@Starfield.constructor.code
  const count = 300;
  const geometry = new three.BufferGeometry();
  const positions = new Float32Array(count * 3);
  const colors = new Float32Array(count * 3);
  
  for (let i = 0; i < count; i++) {
    positions[i * 3] = (Math.random() * 2 - 1) * 80;
    positions[i * 3 + 1] = Math.random() * 40 + 2; 
    positions[i * 3 + 2] = -Math.random() * 150;  
    
    const isPink = Math.random() > 0.5;
    colors[i * 3] = isPink ? 0.95 : 0.2;
    colors[i * 3 + 1] = isPink ? 0.2 : 0.85;
    colors[i * 3 + 2] = isPink ? 0.85 : 0.95;
  }
  
  geometry.setAttribute('position', new three.BufferAttribute(positions, 3));
  geometry.setAttribute('color', new three.BufferAttribute(colors, 3));
  
  const material = new three.PointsMaterial({
    size: 0.6,
    vertexColors: true,
    transparent: true,
    opacity: 0.8,
    sizeAttenuation: true
  });
  
  this.points = new three.Points(geometry, material);
@@Starfield.constructor.end

@Starfield.update{speed: number}: void
@@Starfield.update.code
  const posAttr = this.points.geometry.attributes.position;
  const count = posAttr.count;
  
  for (let i = 0; i < count; i++) {
    let z = posAttr.getZ(i);
    z += speed * 0.15;
    if (z > 10) {
      z = -150 - Math.random() * 20; 
      posAttr.setX(i, (Math.random() * 2 - 1) * 80);
      posAttr.setY(i, Math.random() * 40 + 2);
    }
    posAttr.setZ(i, z);
  }
  posAttr.needsUpdate = true;
@@Starfield.update.end


Obstacle[Obstacle.ts{mesh: any, baseX: number, z: number, speed: number, type: string, size: number, active: boolean}]
@Obstacle.constructor{baseX: number, z: number, speed: number, type: string}
@@Obstacle.constructor.code
  this.baseX = baseX;
  this.z = z;
  this.speed = speed;
  this.type = type;
  this.active = true;
  this.size = Math.random() * 0.6 + 1.2; 
  
  let geometry;
  let material;
  
  if (type === 'pyramid') {
    geometry = new three.ConeGeometry(this.size, this.size * 2, 4);
    material = new three.MeshStandardMaterial({
      color: 0xf43f5e, 
      emissive: 0x9f1239,
      roughness: 0.1,
      metalness: 0.9,
      wireframe: Math.random() > 0.7
    });
  } else {
    geometry = new three.BoxGeometry(this.size, this.size * 2, this.size);
    material = new three.MeshStandardMaterial({
      color: 0x06b6d4, 
      emissive: 0x0891b2,
      roughness: 0.1,
      metalness: 0.9
    });
  }
  
  this.mesh = new three.Mesh(geometry, material);
  this.mesh.position.set(baseX, this.size, z);
  this.mesh.castShadow = true;
  this.mesh.receiveShadow = true;
@@Obstacle.constructor.end

@Obstacle.update{delta: number, speed: number, curve: number}: void
@@Obstacle.update.code
  if (!this.active) return;
  this.z += speed * delta;
  
  const zFactor = Math.max(0, -this.z - 5);
  const curveX = curve * Math.pow(zFactor * 0.005, 2);
  
  this.mesh.position.set(this.baseX + curveX, this.size, this.z);
  
  if (this.type === 'pyramid') {
    this.mesh.rotation.y += delta * 1.5;
  } else {
    this.mesh.rotation.x += delta * 0.8;
    this.mesh.rotation.y += delta * 0.5;
  }
@@Obstacle.update.end


Core[Core.ts{mesh: any, baseX: number, baseY: number, z: number, active: boolean, rotationSpeed: number}]
@Core.constructor{baseX: number, z: number}
@@Core.constructor.code
  this.baseX = baseX;
  this.baseY = Math.random() * 1.2 + 1.2; 
  this.z = z;
  this.active = true;
  this.rotationSpeed = Math.random() * 2 + 1.5;
  
  const geometry = new three.TorusGeometry(0.6, 0.18, 8, 24);
  const material = new three.MeshStandardMaterial({
    color: 0xeab308, 
    emissive: 0xca8a04,
    roughness: 0.1,
    metalness: 1.0,
    emissiveIntensity: 0.8
  });
  
  this.mesh = new three.Mesh(geometry, material);
  this.mesh.position.set(baseX, this.baseY, z);
@@Core.constructor.end

@Core.update{delta: number, speed: number, curve: number, time: number}: void
@@Core.update.code
  if (!this.active) return;
  this.z += speed * delta;
  
  const zFactor = Math.max(0, -this.z - 5);
  const curveX = curve * Math.pow(zFactor * 0.005, 2);
  
  const bob = Math.sin(time * 5 + this.baseX) * 0.25;
  this.mesh.position.set(this.baseX + curveX, this.baseY + bob, this.z);
  
  this.mesh.rotation.y += delta * this.rotationSpeed;
  this.mesh.rotation.x += delta * 0.5;
@@Core.update.end


Player[Player.ts{mesh: any, targetX: number, currentX: number, targetTilt: number, currentTilt: number, score: number, multiplier: number, health: number, energy: number, invincible: boolean, invincibleTimer: number}]
@Player.constructor{}
@@Player.constructor.code
  this.targetX = 0;
  this.currentX = 0;
  this.targetTilt = 0;
  this.currentTilt = 0;
  this.score = 0;
  this.multiplier = 1;
  this.health = 100;
  this.energy = 0; 
  this.invincible = false;
  this.invincibleTimer = 0;
  
  const geometry = new three.ConeGeometry(0.8, 2.2, 3);
  geometry.rotateX(Math.PI / 2); 
  
  const material = new three.MeshStandardMaterial({
    color: 0xa855f7, 
    emissive: 0x6b21a8,
    roughness: 0.1,
    metalness: 0.8,
    emissiveIntensity: 0.6
  });
  
  this.mesh = new three.Mesh(geometry, material);
  
  const wingGeo = new three.BoxGeometry(2.0, 0.15, 0.6);
  const wingMat = new three.MeshStandardMaterial({
    color: 0xc084fc,
    emissive: 0xa855f7
  });
  const wings = new three.Mesh(wingGeo, wingMat);
  wings.position.set(0, -0.2, 0.2);
  this.mesh.add(wings);
  
  const engineGeo = new three.BoxGeometry(0.2, 0.2, 0.3);
  const engineMat = new three.MeshBasicMaterial({ color: 0x06b6d4 });
  
  const leftEngine = new three.Mesh(engineGeo, engineMat);
  leftEngine.position.set(-0.35, -0.1, 1.1);
  const rightEngine = new three.Mesh(engineGeo, engineMat);
  rightEngine.position.set(0.35, -0.1, 1.1);
  
  this.mesh.add(leftEngine, rightEngine);
  this.mesh.position.set(0, 1.0, -4);
@@Player.constructor.end

@Player.update{delta: number, curve: number}: void
@@Player.update.code
  this.currentX += (this.targetX - this.currentX) * 12 * delta;
  
  const steerDir = this.targetX - this.currentX;
  this.targetTilt = -steerDir * 0.25; 
  this.currentTilt += (this.targetTilt - this.currentTilt) * 10 * delta;
  
  this.mesh.position.x = this.currentX;
  this.mesh.rotation.z = this.currentTilt;
  this.mesh.rotation.y = this.currentTilt * 0.4; 
  
  if (this.invincible) {
    this.invincibleTimer -= delta;
    const intensity = Math.sin(Date.now() * 0.05) * 0.5 + 0.5;
    const material = this.mesh.material as any;
    if (material.emissive) {
      material.emissive.setHex(intensity > 0.5 ? 0xeab308 : 0x06b6d4);
      material.emissiveIntensity = 2.0;
    }
    
    if (this.invincibleTimer <= 0) {
      this.invincible = false;
      this.energy = 0;
      const mat = this.mesh.material as any;
      mat.emissive.setHex(0x6b21a8);
      mat.emissiveIntensity = 0.6;
    }
  }
@@Player.update.end

@Player.triggerHyperBoost{}: void
@@Player.triggerHyperBoost.code
  this.invincible = true;
  this.invincibleTimer = 5.0; 
  this.energy = 100; 
@@Player.triggerHyperBoost.end


GameApp[GameApp.ts{scene: any, camera: any, renderer: any, sound: any, sun: any, grid: any, stars: any, player: any, obstacles: any[], cores: any[], particles: any[], speed: number, maxSpeed: number, gameState: string, time: number, score: number, curve: number, nextCurve: number, curveTimer: number, highScores: number[]}]
GameApp --> SoundEngine
GameApp --> RetroSun
GameApp --> GridFloor
GameApp --> Starfield
GameApp --> Player
GameApp --> Obstacle
GameApp --> Core

@GameApp.constructor{}
@@GameApp.constructor.code
  this.scene = new three.Scene();
  this.scene.background = new three.Color(0x09090b);
  this.scene.fog = new three.FogExp2(0x09090b, 0.015); 
  
  this.camera = new three.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
  this.camera.position.set(0, 3.2, 4); 
  this.camera.lookAt(0, 1.8, -10);
  
  this.renderer = new three.WebGLRenderer({ antialias: true, alpha: false });
  this.renderer.setSize(window.innerWidth, window.innerHeight);
  this.renderer.shadowMap.enabled = true;
  document.body.appendChild(this.renderer.domElement);
  
  this.scene.add(new three.AmbientLight(0x221c35, 1.5));
  
  const light = new three.DirectionalLight(0xc084fc, 1.5);
  light.position.set(0, 15, 10);
  light.castShadow = true;
  this.scene.add(light);
  
  this.sound = new SoundEngine();
  this.sun = new RetroSun();
  this.scene.add(this.sun.mesh);
  
  this.grid = new GridFloor();
  this.scene.add(this.grid.mesh);
  
  this.stars = new Starfield();
  this.scene.add(this.stars.points);
  
  this.player = new Player();
  this.scene.add(this.player.mesh);
  
  this.obstacles = [];
  this.cores = [];
  this.particles = [];
  
  this.speed = 15;
  this.maxSpeed = 48;
  this.gameState = 'START'; 
  this.time = 0;
  this.score = 0;
  this.curve = 0;
  this.nextCurve = 0;
  this.curveTimer = 0;
  
  try {
    const saved = localStorage.getItem('cyberdodge_highscores');
    this.highScores = saved ? JSON.parse(saved) : [5000, 2500, 1000];
  } catch(e) {
    this.highScores = [5000, 2500, 1000];
  }
  
  window.addEventListener('keydown', (e) => this.handleKeyDown(e));
  window.addEventListener('keyup', (e) => this.handleKeyUp(e));
  window.addEventListener('resize', () => this.handleResize());
  
  window.addEventListener('touchstart', (e) => this.handleTouch(e));
  window.addEventListener('touchmove', (e) => this.handleTouch(e));
  
  this.setupDomEvents();
@@GameApp.constructor.end

@GameApp.setupDomEvents{}: void
@@GameApp.setupDomEvents.code
  const playBtn = document.getElementById('play-btn');
  if (playBtn) {
    playBtn.addEventListener('click', () => this.startGame());
  }
  const restartBtn = document.getElementById('restart-btn');
  if (restartBtn) {
    restartBtn.addEventListener('click', () => this.startGame());
  }
  const muteBtn = document.getElementById('mute-btn');
  if (muteBtn) {
    muteBtn.addEventListener('click', () => {
      this.sound.toggleMute();
      muteBtn.innerText = this.sound.isMuted ? "🔇" : "🔊";
    });
  }
@@GameApp.setupDomEvents.end

@GameApp.startGame{}: void
@@GameApp.startGame.code
  this.sound.init();
  this.gameState = 'PLAY';
  this.score = 0;
  this.speed = 15;
  
  this.player.score = 0;
  this.player.health = 100;
  this.player.energy = 0;
  this.player.multiplier = 1;
  this.player.invincible = false;
  this.player.targetX = 0;
  this.player.currentX = 0;
  
  for (const obs of this.obstacles) this.scene.remove(obs.mesh);
  for (const c of this.cores) this.scene.remove(c.mesh);
  for (const p of this.particles) this.scene.remove(p.mesh);
  
  this.obstacles = [];
  this.cores = [];
  this.particles = [];
  
  const startScreen = document.getElementById('start-screen');
  if (startScreen) startScreen.style.display = 'none';
  const overScreen = document.getElementById('gameover-screen');
  if (overScreen) overScreen.style.display = 'none';
  const hud = document.getElementById('hud');
  if (hud) hud.style.display = 'flex';
@@GameApp.startGame.end

@GameApp.gameOver{}: void
@@GameApp.gameOver.code
  this.gameState = 'GAMEOVER';
  this.sound.playGameOver();
  
  this.highScores.push(Math.round(this.score));
  this.highScores.sort((a, b) => b - a);
  this.highScores = this.highScores.slice(0, 5); 
  try {
    localStorage.setItem('cyberdodge_highscores', JSON.stringify(this.highScores));
  } catch(e) {}
  
  const finalScoreEl = document.getElementById('final-score');
  if (finalScoreEl) finalScoreEl.innerText = Math.round(this.score).toString();
  
  const scoreList = document.getElementById('highscores-list');
  if (scoreList) {
    scoreList.innerHTML = this.highScores.map((s, idx) => 
      `<li><span>#${idx+1}</span><strong>${s} pts</strong></li>`
    ).join('');
  }
  
  const hud = document.getElementById('hud');
  if (hud) hud.style.display = 'none';
  const overScreen = document.getElementById('gameover-screen');
  if (overScreen) overScreen.style.display = 'flex';
@@GameApp.gameOver.end

@GameApp.spawnObstacle{}: void
@@GameApp.spawnObstacle.code
  const lanes = [-6, -3, 0, 3, 6];
  const laneIndex = Math.floor(Math.random() * lanes.length);
  const laneX = lanes[laneIndex];
  
  const type = Math.random() > 0.5 ? 'pyramid' : 'cube';
  const speed = -this.speed;
  
  const obs = new Obstacle(laneX, -150, speed, type);
  this.scene.add(obs.mesh);
  this.obstacles.push(obs);
@@GameApp.spawnObstacle.end

@GameApp.spawnCore{}: void
@@GameApp.spawnCore.code
  const lanes = [-4.5, -1.5, 1.5, 4.5];
  const laneX = lanes[Math.floor(Math.random() * lanes.length)];
  const core = new Core(laneX, -140);
  this.scene.add(core.mesh);
  this.cores.push(core);
@@GameApp.spawnCore.end

@GameApp.spawnParticles{x: number, y: number, z: number, color: number}: void
@@GameApp.spawnParticles.code
  const count = 12;
  const geo = new three.BoxGeometry(0.15, 0.15, 0.15);
  const mat = new three.MeshBasicMaterial({ color: color });
  
  for (let i = 0; i < count; i++) {
    const mesh = new three.Mesh(geo, mat);
    mesh.position.set(x, y, z);
    
    const vel = new three.Vector3(
      (Math.random() * 2 - 1) * 6,
      (Math.random() * 2 - 1) * 6 + 3,
      (Math.random() * 2 - 1) * 6
    );
    
    this.scene.add(mesh);
    this.particles.push({
      mesh: mesh,
      vel: vel,
      life: 0.6 
    });
  }
@@GameApp.spawnParticles.end

@GameApp.triggerNearMiss{x: number, y: number, z: number}: void
@@GameApp.triggerNearMiss.code
  this.sound.playNearMiss();
  this.player.score += 200 * this.player.multiplier;
  this.player.multiplier += 1;
  
  const alert = document.createElement('div');
  alert.className = 'near-miss-alert';
  alert.innerText = `NEAR MISS x${this.player.multiplier}!`;
  alert.style.left = `${Math.random() * 40 + 30}%`;
  alert.style.top = `${Math.random() * 30 + 30}%`;
  document.body.appendChild(alert);
  setTimeout(() => alert.remove(), 900);
@@GameApp.triggerNearMiss.end

@GameApp.handleKeyDown{e: any}: void
@@GameApp.handleKeyDown.code
  if (this.gameState !== 'PLAY') {
    if (e.key === ' ' || e.key === 'Enter') {
      this.startGame();
    }
    return;
  }
  
  const laneWidth = 3;
  if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') {
    this.player.targetX = Math.max(-6, this.player.targetX - laneWidth);
  }
  if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') {
    this.player.targetX = Math.min(6, this.player.targetX + laneWidth);
  }
@@GameApp.handleKeyDown.end

@GameApp.handleKeyUp{e: any}: void
@@GameApp.handleKeyUp.code
  // Tilt release hook
@@GameApp.handleKeyUp.end

@GameApp.handleTouch{e: any}: void
@@GameApp.handleTouch.code
  if (this.gameState !== 'PLAY') return;
  e.preventDefault();
  const touch = e.touches[0];
  const screenPct = touch.clientX / window.innerWidth;
  if (screenPct < 0.35) {
    this.player.targetX = Math.max(-6, this.player.targetX - 3);
  } else if (screenPct > 0.65) {
    this.player.targetX = Math.min(6, this.player.targetX + 3);
  }
@@GameApp.handleTouch.end

@GameApp.handleResize{}: void
@@GameApp.handleResize.code
  this.camera.aspect = window.innerWidth / window.innerHeight;
  this.camera.updateProjectionMatrix();
  this.renderer.setSize(window.innerWidth, window.innerHeight);
@@GameApp.handleResize.end

@GameApp.updatePhysics{delta: number}: void
@@GameApp.updatePhysics.code
  this.time += delta;
  
  this.curveTimer -= delta;
  if (this.curveTimer <= 0) {
    const rand = Math.random();
    if (rand < 0.3) this.nextCurve = 0; 
    else if (rand < 0.65) this.nextCurve = (Math.random() * 8 + 4); 
    else this.nextCurve = -(Math.random() * 8 + 4); 
    this.curveTimer = Math.random() * 3 + 2.5; 
  }
  this.curve += (this.nextCurve - this.curve) * 1.5 * delta;
  
  if (this.player.invincible) {
    this.speed += (this.maxSpeed - this.speed) * 4 * delta; 
  } else {
    const baseTargetSpeed = 15 + Math.min(20, this.time * 0.1);
    this.speed += (baseTargetSpeed - this.speed) * 2 * delta;
  }
  
  this.sound.setEngineSpeed(this.speed);
  
  this.sun.update(this.time);
  this.grid.update(this.time, this.speed, this.curve);
  this.stars.update(this.speed);
  this.player.update(delta, this.curve);
  
  this.score += delta * this.speed * 0.3 * this.player.multiplier;
  
  const spawnChance = delta * 1.4 + (this.speed * 0.005);
  if (Math.random() < spawnChance && this.obstacles.length < 15) {
    this.spawnObstacle();
  }
  const coreSpawnChance = delta * 0.8;
  if (Math.random() < coreSpawnChance && this.cores.length < 8) {
    this.spawnCore();
  }
  
  for (let i = this.particles.length - 1; i >= 0; i--) {
    const p = this.particles[i];
    p.mesh.position.x += p.vel.x * delta;
    p.mesh.position.y += p.vel.y * delta;
    p.mesh.position.z += p.vel.z * delta;
    
    p.vel.y -= 9.8 * delta;
    p.life -= delta;
    p.mesh.scale.multiplyScalar(0.96);
    
    if (p.life <= 0 || p.mesh.scale.x < 0.05) {
      this.scene.remove(p.mesh);
      this.particles.splice(i, 1);
    }
  }
  
  for (let i = this.obstacles.length - 1; i >= 0; i--) {
    const obs = this.obstacles[i];
    obs.update(delta, this.speed, this.curve);
    
    const distZ = Math.abs(obs.z - this.player.mesh.position.z);
    const distX = Math.abs(obs.mesh.position.x - this.player.currentX);
    
    if (distZ < 1.0 && distX < (obs.size * 0.7 + 0.4)) {
      if (this.player.invincible) {
        this.spawnParticles(obs.mesh.position.x, obs.mesh.position.y, obs.z, 0xf43f5e);
        this.sound.playHit();
        this.score += 500 * this.player.multiplier;
        this.scene.remove(obs.mesh);
        this.obstacles.splice(i, 1);
        continue;
      } else {
        this.spawnParticles(this.player.currentX, 1.0, -4, 0xf43f5e);
        this.sound.playHit();
        this.player.health -= 25;
        this.player.multiplier = 1; 
        
        this.player.targetX = obs.mesh.position.x > this.player.currentX ? -6 : 6;
        
        this.scene.remove(obs.mesh);
        this.obstacles.splice(i, 1);
        
        if (this.player.health <= 0) {
          this.gameOver();
        }
        continue;
      }
    }
    
    if (Math.abs(obs.z - (-4)) < 0.6 && distX < 1.6 && distX >= (obs.size * 0.7 + 0.4) && !obs.mesh.userData.nearMissed && !this.player.invincible) {
      obs.mesh.userData.nearMissed = true;
      this.triggerNearMiss(obs.mesh.position.x, obs.mesh.position.y, obs.z);
    }
    
    if (obs.z > 8) {
      this.scene.remove(obs.mesh);
      this.obstacles.splice(i, 1);
    }
  }
  
  for (let i = this.cores.length - 1; i >= 0; i--) {
    const core = this.cores[i];
    core.update(delta, this.speed, this.curve, this.time);
    
    const distZ = Math.abs(core.z - this.player.mesh.position.z);
    const distX = Math.abs(core.mesh.position.x - this.player.currentX);
    const distY = Math.abs(core.mesh.position.y - this.player.mesh.position.y);
    
    if (distZ < 1.0 && distX < 1.0 && distY < 1.2) {
      this.spawnParticles(core.mesh.position.x, core.mesh.position.y, core.z, 0xeab308);
      this.sound.playCollect();
      
      this.score += 200 * this.player.multiplier;
      this.player.multiplier += 1;
      
      if (!this.player.invincible) {
        this.player.energy = Math.min(100, this.player.energy + 20); 
        if (this.player.energy >= 100) {
          this.player.triggerHyperBoost();
          
          const alert = document.createElement('div');
          alert.className = 'hyper-boost-alert';
          alert.innerText = 'HYPER BOOST INITIALIZED!';
          document.body.appendChild(alert);
          setTimeout(() => alert.remove(), 1500);
        }
      }
      
      this.scene.remove(core.mesh);
      this.cores.splice(i, 1);
      continue;
    }
    
    if (core.z > 8) {
      this.scene.remove(core.mesh);
      this.cores.splice(i, 1);
    }
  }
  
  const scoreVal = document.getElementById('score-val');
  if (scoreVal) scoreVal.innerText = Math.round(this.score).toString();
  
  const multVal = document.getElementById('mult-val');
  if (multVal) multVal.innerText = `x${this.player.multiplier}`;
  
  const shieldVal = document.getElementById('shield-val');
  if (shieldVal) shieldVal.style.width = `${this.player.health}%`;
  
  const boostVal = document.getElementById('boost-val');
  if (boostVal) {
    boostVal.style.width = `${this.player.energy}%`;
    if (this.player.invincible) {
      boostVal.style.backgroundColor = '#eab308'; 
      boostVal.style.boxShadow = '0 0 10px #eab308';
    } else {
      boostVal.style.backgroundColor = '#a855f7'; 
      boostVal.style.boxShadow = 'none';
    }
  }
@@GameApp.updatePhysics.end

@GameApp.animate{}: void
@@GameApp.animate.code
  requestAnimationFrame(() => this.animate());
  
  if (this.gameState === 'PLAY') {
    const delta = Math.min(0.1, 1 / 60); 
    this.updatePhysics(delta);
  }
  
  this.renderer.render(this.scene, this.camera);
@@GameApp.animate.end


// --- Rollup Configuration ---
Rollup->{SoundEngine.ts, RetroSun.ts, GridFloor.ts, Starfield.ts, Obstacle.ts, Core.ts, Player.ts, GameApp.ts}


// --- Main Entry ---
@@main.code
  console.log("CyberDodge successfully loaded and bundled!");
@@main.end


// --- Web Interface ---
web->index.html.code
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CyberDodge // Synthwave retro arcade racer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800;900&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-drag: none;
        }
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #09090b;
            color: #e4e4e7;
            font-family: 'Outfit', system-ui, sans-serif;
        }
        canvas {
            display: block;
            width: 100%;
            height: 100%;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 1;
        }
        .ui-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 10;
            pointer-events: none;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 30px;
        }
        .interactive {
            pointer-events: auto;
        }
        
        /* Glassmorphic panels */
        .glass-panel {
            background: rgba(15, 15, 25, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            padding: 20px 25px;
            transition: all 0.3s ease;
        }
        
        /* Top HUD */
        .hud-header {
            display: none; /* Show only when playing */
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }
        .stat-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .stat-label {
            font-size: 0.8rem;
            color: #a1a1aa;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-weight: 600;
        }
        .stat-value {
            font-size: 2.2rem;
            font-weight: 900;
            line-height: 1;
            color: #ffffff;
            text-shadow: 0 0 15px rgba(255, 255, 255, 0.2);
        }
        .accent-pink {
            background: linear-gradient(135deg, #f43f5e, #ec4899);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .accent-purple {
            background: linear-gradient(135deg, #c084fc, #a855f7);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .accent-yellow {
            background: linear-gradient(135deg, #fef08a, #eab308);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        /* Bars */
        .hud-bars {
            display: flex;
            gap: 20px;
        }
        .bar-container {
            display: flex;
            flex-direction: column;
            gap: 6px;
            width: 160px;
        }
        .bar-track {
            height: 10px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 5px;
            overflow: hidden;
            width: 100%;
        }
        .bar-fill {
            height: 100%;
            width: 100%;
            transition: width 0.15s ease-out;
        }
        .shield-fill {
            background: linear-gradient(to right, #ef4444, #f43f5e);
            box-shadow: 0 0 10px rgba(244, 63, 94, 0.4);
        }
        .boost-fill {
            background: linear-gradient(to right, #8b5cf6, #c084fc);
            box-shadow: 0 0 10px rgba(192, 132, 252, 0.4);
        }
        
        /* Screen Overlays */
        .screen-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 100;
            padding: 20px;
        }
        .overlay-card {
            width: 100%;
            max-width: 480px;
            text-align: center;
            display: flex;
            flex-direction: column;
            gap: 25px;
            pointer-events: auto;
            border-color: rgba(192, 132, 252, 0.15);
            animation: cardEntrance 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        
        @keyframes cardEntrance {
            from { transform: translateY(30px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        
        .logo-text {
            font-size: 3.5rem;
            font-weight: 900;
            letter-spacing: -0.03em;
            text-transform: uppercase;
            line-height: 0.9;
            margin-bottom: 5px;
            background: linear-gradient(to bottom, #ffffff 40%, #c084fc 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 0 15px rgba(192, 132, 252, 0.3));
        }
        .logo-tagline {
            color: #a1a1aa;
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            font-weight: 600;
        }
        
        /* Buttons */
        .btn {
            background: linear-gradient(135deg, #a855f7, #ec4899);
            border: none;
            color: #ffffff;
            font-size: 1.1rem;
            font-weight: 800;
            padding: 16px 32px;
            border-radius: 12px;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            box-shadow: 0 0 20px rgba(168, 85, 247, 0.35);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 30px rgba(236, 72, 153, 0.5);
        }
        .btn:active {
            transform: translateY(1px);
        }
        .mute-btn {
            position: absolute;
            top: 30px;
            right: 30px;
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            cursor: pointer;
            z-index: 1000;
            pointer-events: auto;
            font-size: 1.2rem;
            transition: all 0.2s;
        }
        .mute-btn:hover {
            background: rgba(255, 255, 255, 0.1);
        }
        
        /* Scores list */
        .scores-box {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 12px;
            padding: 15px 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .scores-title {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #a1a1aa;
            font-weight: 600;
        }
        .scores-list {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .scores-list li {
            display: flex;
            justify-content: space-between;
            font-size: 0.95rem;
        }
        .scores-list li span {
            color: #71717a;
        }
        
        /* Floating alerts */
        .near-miss-alert {
            position: absolute;
            font-size: 1.4rem;
            font-weight: 900;
            color: #06b6d4;
            text-shadow: 0 0 10px rgba(6, 182, 212, 0.6);
            pointer-events: none;
            animation: alertFloat 0.9s cubic-bezier(0.1, 0.8, 0.3, 1) forwards;
            z-index: 90;
        }
        .hyper-boost-alert {
            position: absolute;
            top: 30%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 2.2rem;
            font-weight: 900;
            color: #eab308;
            text-shadow: 0 0 20px rgba(234, 179, 8, 0.8);
            pointer-events: none;
            animation: alertScale 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            z-index: 95;
            letter-spacing: -0.02em;
        }
        
        @keyframes alertFloat {
            0% { transform: translateY(0) scale(0.8); opacity: 0; }
            15% { opacity: 1; transform: translateY(-10px) scale(1.1); }
            100% { transform: translateY(-60px) scale(0.9); opacity: 0; }
        }
        @keyframes alertScale {
            0% { transform: translate(-50%, -50%) scale(0.6); opacity: 0; }
            15% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
            80% { opacity: 1; transform: translate(-50%, -50%) scale(1.0); }
            100% { transform: translate(-50%, -100%) scale(0.8); opacity: 0; }
        }
        
        /* Instructions card */
        .instruct {
            font-size: 0.85rem;
            color: #71717a;
            line-height: 1.4;
        }
    </style>
</head>
<body>
    <button id="mute-btn" class="mute-btn">🔊</button>

    <!-- Start Overlay -->
    <div id="start-screen" class="screen-overlay">
        <div class="glass-panel overlay-card">
            <div>
                <h1 class="logo-text">CyberDodge</h1>
                <p class="logo-tagline">Neon Horizon Racer</p>
            </div>
            <p class="instruct">
                Navigate the glowing grid. Dodge hazardous cubes and pyramids. Collect gold energy rings to charge your boost!
            </p>
            <div style="font-size: 0.9rem; color: #a1a1aa;">
                <strong>A / D</strong> or <strong>← / →</strong> keys to steer<br>
                Or <strong>click sides</strong> of the screen
            </div>
            <button id="play-btn" class="btn">Engines Start</button>
        </div>
    </div>

    <!-- Game Over Overlay -->
    <div id="gameover-screen" class="screen-overlay" style="display: none;">
        <div class="glass-panel overlay-card">
            <div>
                <h1 class="logo-text accent-pink">CRASH DETECTED</h1>
                <p class="logo-tagline">Systems Offline</p>
            </div>
            <div class="stat-group">
                <span class="stat-label">Final Score</span>
                <span id="final-score" class="stat-value accent-yellow" style="font-size: 3.5rem;">0</span>
            </div>
            <div class="scores-box">
                <h3 class="scores-title">High Scores</h3>
                <ul id="highscores-list" class="scores-list">
                    <!-- filled dynamically -->
                </ul>
            </div>
            <button id="restart-btn" class="btn">Retry Simulation</button>
        </div>
    </div>

    <!-- Play HUD Overlay -->
    <div class="ui-container">
        <!-- Top row: score and multiplier -->
        <div id="hud" class="hud-header">
            <div class="stat-group">
                <span class="stat-label">Score</span>
                <span id="score-val" class="stat-value">0</span>
            </div>
            <div class="stat-group" style="align-items: center;">
                <span class="stat-label">Multiplier</span>
                <span id="mult-val" class="stat-value accent-purple">x1</span>
            </div>
            <div class="hud-bars">
                <div class="bar-container">
                    <span class="stat-label">Hull Shield</span>
                    <div class="bar-track">
                        <div id="shield-val" class="bar-fill shield-fill" style="width: 100%"></div>
                    </div>
                </div>
                <div class="bar-container">
                    <span class="stat-label">Hyper Energy</span>
                    <div class="bar-track">
                        <div id="boost-val" class="bar-fill boost-fill" style="width: 0%"></div>
                    </div>
                </div>
            </div>
        </div>
        
        <div></div> <!-- spacer -->
    </div>

    <!-- Bundle loader -->
    <script type="module">
        import { GameApp } from './compiled.js';
        
        // Instantiate and loop
        const app = new GameApp();
        app.animate();
    </script>
</body>
</html>
web->index.html.end

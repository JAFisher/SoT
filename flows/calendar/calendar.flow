  cliscripts->start npx -y http-server -p 3003 -c-1

  CalendarTheme[CalendarTheme.ts{accent: string, deep: string, highlight: string}]
  CalendarEvent[CalendarEvent.ts{id: string, title: string, time: string, category: string, date: string, desc: string}]
  CalendarState[CalendarState.ts{events: CalendarEvent[]}]

  Badge[Badge.tsx{}]
  EventCard[EventCard.tsx{}]
  Sidebar[Sidebar.tsx{}]
  DayCell[DayCell.tsx{}]

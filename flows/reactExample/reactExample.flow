!object
graph TD
  cliscripts->start npx -y http-server -p 3002

  SplashTheme[SplashTheme.ts{accent: string, deep: string, highlight: string}]
  MissionStat[MissionStat.ts{label: string, value: string, tone: string}]
  TelemetryPacket[TelemetryPacket.ts{callsign: string, status: string, velocity: string, orbit: string, signal: string, window: string, theme: SplashTheme, stats: MissionStat[]}]

  Badge[Badge.tsx{}]
  CommandButton[CommandButton.tsx{}]
  StatChip[StatChip.tsx{}]
  StatRail[StatRail.tsx{}]
  SystemCard[SystemCard.tsx{}]
  SignalGrid[SignalGrid.tsx{}]
  HeroPanel[HeroPanel.tsx{}]
  LaunchConsole[LaunchConsole.tsx{}]
  SplashPage[SplashPage.tsx{}]

  TelemetryPacket --> SplashTheme
  TelemetryPacket --> MissionStat
  StatChip --> MissionStat
  StatRail --> StatChip
  HeroPanel --> Badge
  HeroPanel --> CommandButton
  HeroPanel --> StatRail
  LaunchConsole --> Badge
  LaunchConsole --> SignalGrid
  LaunchConsole --> SystemCard
  SplashPage --> HeroPanel
  SplashPage --> LaunchConsole

  @SplashTheme.tokens{}: any
  @@SplashTheme.tokens.code
    return {
      shell: `radial-gradient(circle at 18% 18%, ${this.highlight} 0, transparent 30%), linear-gradient(135deg, ${this.deep} 0%, #111827 52%, #e5f6ff 52%, #f8fafc 100%)`,
      accent: this.accent,
      deep: this.deep,
      highlight: this.highlight,
      ink: "#0f172a",
      paper: "#ffffff"
    };
  @@SplashTheme.tokens.end

  @TelemetryPacket.summary{}: string
  @@TelemetryPacket.summary.code
    return `${this.callsign} is ${this.status.toLowerCase()} at ${this.velocity}, holding ${this.orbit}.`;
  @@TelemetryPacket.summary.end

  @Badge.constructor{props: any}
  @@Badge.constructor.code
    const React = window.React;
    const { label, tone } = props;
    return (
      <div className={`badge badge-${tone}`}>
        <span className="badge-dot" />
        {label}
      </div>
    );
  @@Badge.constructor.end

  @CommandButton.constructor{props: any}
  @@CommandButton.constructor.code
    const React = window.React;
    const { label, variant } = props;
    return (
      <button className={`command-button ${variant}`} type="button">
        {label}
      </button>
    );
  @@CommandButton.constructor.end

  @StatChip.constructor{props: any}
  @@StatChip.constructor.code
    const React = window.React;
    const { stat } = props;
    return (
      <div className={`stat-chip stat-${stat.tone}`}>
        <span>{stat.label}</span>
        <strong>{stat.value}</strong>
      </div>
    );
  @@StatChip.constructor.end

  @StatRail.constructor{props: any}
  @@StatRail.constructor.code
    const React = window.React;
    const { stats } = props;
    return (
      <div className="stat-rail">
        {stats.map((stat) => <StatChip key={stat.label} stat={stat} />)}
      </div>
    );
  @@StatRail.constructor.end

  @SystemCard.constructor{props: any}
  @@SystemCard.constructor.code
    const React = window.React;
    const { title, body, metric, tone } = props;
    return (
      <article className={`system-card card-${tone}`}>
        <p>{title}</p>
        <strong>{metric}</strong>
        <span>{body}</span>
      </article>
    );
  @@SystemCard.constructor.end

  @SignalGrid.constructor{props: any}
  @@SignalGrid.constructor.code
    const React = window.React;
    const { rows } = props;
    const cells = Array.from({ length: rows * 6 }, (_, index) => index);
    return (
      <div className="signal-grid" aria-hidden="true">
        {cells.map((cell) => (
          <span key={cell} style={{ opacity: 0.25 + ((cell % 6) * 0.12) }} />
        ))}
      </div>
    );
  @@SignalGrid.constructor.end

  @HeroPanel.constructor{props: any}
  @@HeroPanel.constructor.code
    const React = window.React;
    const { packet } = props;
    return (
      <section className="hero-panel">
        <Badge label="Live object-flow render" tone="cyan" />
        <h1>{packet.callsign}</h1>
        <p className="lede">{packet.summary()}</p>
        <div className="actions">
          <CommandButton label="Open console" variant="primary" />
          <CommandButton label="View generated flow" variant="ghost" />
        </div>
        <StatRail stats={packet.stats} />
      </section>
    );
  @@HeroPanel.constructor.end

  @LaunchConsole.constructor{props: any}
  @@LaunchConsole.constructor.code
    const React = window.React;
    const { packet } = props;
    return (
      <section className="console-panel" aria-label="Mission console">
        <div className="console-header">
          <Badge label={packet.status} tone="green" />
          <span>{packet.window}</span>
        </div>
        <SignalGrid rows={7} />
        <div className="card-grid">
          <SystemCard title="Velocity" body="Cruise corridor locked" metric={packet.velocity} tone="blue" />
          <SystemCard title="Orbit" body="Transfer path stable" metric={packet.orbit} tone="violet" />
          <SystemCard title="Signal" body="Telemetry streaming cleanly" metric={packet.signal} tone="green" />
        </div>
      </section>
    );
  @@LaunchConsole.constructor.end

  @SplashPage.constructor{props: any}
  @@SplashPage.constructor.code
    const React = window.React;
    const { packet } = props;
    const tokens = packet.theme.tokens();
    return (
      <main className="splash-shell" style={{ background: tokens.shell }}>
        <HeroPanel packet={packet} />
        <LaunchConsole packet={packet} />
      </main>
    );
  @@SplashPage.constructor.end

  Rollup->{SplashTheme.ts, MissionStat.ts, TelemetryPacket.ts, Badge.tsx, CommandButton.tsx, StatChip.tsx, StatRail.tsx, SystemCard.tsx, SignalGrid.tsx, HeroPanel.tsx, LaunchConsole.tsx, SplashPage.tsx}

  web->index.html.code
  <!DOCTYPE html>
  <html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SoT React Mission Control</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&display=swap" rel="stylesheet">
    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Inter", system-ui, sans-serif;
        color: #0f172a;
        background: #111827;
      }

      button {
        font: inherit;
      }

      .splash-shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(340px, 560px);
        align-items: center;
        gap: clamp(34px, 6vw, 90px);
        padding: clamp(28px, 6vw, 80px);
        overflow: hidden;
      }

      .hero-panel {
        color: #ffffff;
        max-width: 760px;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 34px;
        padding: 0 12px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(14px);
        color: #ffffff;
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
      }

      .badge-dot {
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: currentColor;
        box-shadow: 0 0 18px currentColor;
      }

      .badge-cyan {
        color: #67e8f9;
      }

      .badge-green {
        color: #86efac;
      }

      h1 {
        max-width: 10ch;
        margin: 28px 0 18px;
        color: #ffffff;
        font-size: clamp(3.4rem, 9vw, 7.6rem);
        line-height: 0.9;
        letter-spacing: 0;
      }

      .lede {
        max-width: 650px;
        margin: 0;
        color: rgba(255, 255, 255, 0.78);
        font-size: clamp(1.2rem, 2.4vw, 2rem);
        line-height: 1.3;
        font-weight: 700;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
      }

      .command-button {
        min-height: 48px;
        border-radius: 8px;
        padding: 0 18px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #ffffff;
        font-weight: 800;
        cursor: pointer;
      }

      .command-button.primary {
        border: 0;
        background: #ffffff;
        color: #0f172a;
        box-shadow: 0 20px 45px rgba(15, 23, 42, 0.28);
      }

      .command-button.ghost {
        background: rgba(255, 255, 255, 0.1);
      }

      .stat-rail {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        max-width: 650px;
        margin-top: 34px;
      }

      .stat-chip {
        min-height: 86px;
        padding: 16px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.11);
        border: 1px solid rgba(255, 255, 255, 0.14);
        backdrop-filter: blur(14px);
      }

      .stat-chip span {
        display: block;
        color: rgba(255, 255, 255, 0.62);
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
      }

      .stat-chip strong {
        display: block;
        margin-top: 10px;
        color: #ffffff;
        font-size: clamp(1.25rem, 3vw, 2rem);
      }

      .console-panel {
        width: min(100%, 560px);
        justify-self: end;
        padding: 18px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.86);
        border: 1px solid rgba(15, 23, 42, 0.12);
        box-shadow: 0 34px 90px rgba(15, 23, 42, 0.32);
      }

      .console-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 8px 8px 18px;
        color: #475569;
        font-size: 0.88rem;
        font-weight: 800;
      }

      .signal-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 8px;
        min-height: 236px;
        padding: 16px;
        border-radius: 8px;
        background: #0f172a;
      }

      .signal-grid span {
        min-height: 20px;
        border-radius: 6px;
        background: linear-gradient(135deg, #67e8f9, #2563eb);
      }

      .card-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-top: 12px;
      }

      .system-card {
        min-height: 142px;
        padding: 14px;
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .system-card p {
        margin: 0;
        color: #64748b;
        font-size: 0.72rem;
        font-weight: 800;
        text-transform: uppercase;
      }

      .system-card strong {
        color: #0f172a;
        font-size: 1.35rem;
        line-height: 1.05;
      }

      .system-card span {
        color: #64748b;
        font-size: 0.82rem;
        line-height: 1.4;
      }

      .card-blue {
        border-top: 4px solid #2563eb;
      }

      .card-violet {
        border-top: 4px solid #7c3aed;
      }

      .card-green {
        border-top: 4px solid #16a34a;
      }

      @media (max-width: 900px) {
        .splash-shell {
          grid-template-columns: 1fr;
          padding: 28px;
        }

        .console-panel {
          justify-self: stretch;
        }
      }

      @media (max-width: 620px) {
        .stat-rail,
        .card-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <div id="root"></div>

    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script type="module">
      import { SplashTheme, MissionStat, TelemetryPacket, SplashPage } from "./compiled.js";

      const theme = SplashTheme("#2563eb", "#0f172a", "rgba(103, 232, 249, 0.34)");
      const packet = TelemetryPacket(
        "ORBITAL",
        "Nominal",
        "27,400 km/h",
        "LEO-82",
        "98.7%",
        "T-minus 04:18",
        theme,
        [
          MissionStat("Altitude", "408 km", "blue"),
          MissionStat("Crew", "4 online", "green"),
          MissionStat("Payload", "Stable", "violet")
        ]
      );

      ReactDOM.createRoot(document.getElementById("root")).render(
        React.createElement(SplashPage, { packet })
      );
    </script>
  </body>
  </html>
  web->index.html.end
